# Template only. Copy values into the host's private environment settings.
# No account, password, key or database credential is supplied here.
NODE_ENV=production
ACCESS_MODE=owner-password
PUBLIC_ORIGIN=https://intel.insightfuldefense.com
# Optional editor link in public mode; must be a GoDaddy private preview HTTPS origin.
PRIVATE_PREVIEW_URL=
IMPORT_REQUIRED=true
ENABLE_SCHEDULER=false

# ACCESS_MODE choices:
# owner-password (also the default when unset): requires the owner secrets below.
# godaddy-private-preview: no app owner password or SESSION_SECRET. Use only behind
# GoDaddy's existing account-gated private preview. PUBLIC_ORIGIN must be the actual
# https://<single-label>.preview.c38.airoapp.ai origin, not a custom/public hostname.
# public: public read-only assets/workspace, no shared-data edits, collection,
# import or backup. Validated brief exports are temporary and are not saved.
# Review the shared database's content before publishing it through public mode.
# Public mode remains unavailable while IMPORT_REQUIRED is pending.

# Use DATABASE_URL OR all four DB_* credentials. URL-encode credentials in a URL.
DATABASE_URL=
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Optional trusted provider CA PEM. Hostname and certificate validation remain enabled.
DB_SSL_CA=
# Optional explicit trusted provider TLS DNS identity for an IP or proxy endpoint.
# The original DB_HOST/DB_PORT still route the connection. Both checks stay enabled.
DB_TLS_SERVERNAME=

# Required only in owner-password mode; leave absent in passwordless access modes.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Set ADMIN_PASSWORD only when ADMIN_PASSWORD_HASH is absent.
ADMIN_PASSWORD=
SESSION_SECRET=

# The host supplies PORT. This example is for manual local startup only.
PORT=3000
# DATA_DIR is local SQLite development only; never point it at public/assets.
# DATA_DIR=/absolute/private/local-directory
# ALLOW_INSECURE_LOCALHOST=true
