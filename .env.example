# Template only. Copy values into the host's private environment settings.
# No account, password, key or database credential is supplied here.
NODE_ENV=production
PUBLIC_ORIGIN=https://intel.insightfuldefense.com
IMPORT_REQUIRED=true
ENABLE_SCHEDULER=false

# Use DATABASE_URL OR all four DB_* credentials. URL-encode credentials in a URL.
DATABASE_URL=
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Optional trusted provider CA PEM. Hostname and certificate validation remain enabled.
DB_SSL_CA=

ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Set ADMIN_PASSWORD only when ADMIN_PASSWORD_HASH is absent.
ADMIN_PASSWORD=
SESSION_SECRET=

# The host supplies PORT. This example is for manual local startup only.
PORT=3000
# DATA_DIR is local SQLite development only; never point it at public/assets.
# DATA_DIR=/absolute/private/local-directory
# ALLOW_INSECURE_LOCALHOST=true
